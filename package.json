{
  "name": "sdet-toolshop-demo",
  "version": "1.0.0",
  "description": "Playwright + TypeScript demo framework (Web E2E + API) against Toolshop",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:web": "playwright test tests/web",
    "test:web:public": "playwright test --project=web-public",
    "test:web:auth": "playwright test --project=web-auth",
    "test:api": "playwright test tests/api",
    "test:smoke": "playwright test --grep @smoke",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "PWDEBUG=1 playwright test",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:serve": "allure serve allure-results",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json,md,yml,yaml}": "prettier --write"
  },
  "keywords": [
    "playwright",
    "typescript",
    "qa",
    "automation",
    "e2e",
    "api"
  ],
  "license": "MIT",
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "1.61.1",
    "@types/node": "^26.0.1",
    "allure-commandline": "^2.43.0",
    "allure-js-commons": "^3.10.1",
    "allure-playwright": "^3.9.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.5.0",
    "eslint-plugin-playwright": "^2.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "zod": "^4.4.3"
  }
}
